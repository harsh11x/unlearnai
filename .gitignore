# Dependencies
node_modules/
.venv/
__pycache__/
*.pyc

# Build output
.next/
.out/
dist/
build/

# Environment
.env
.env.local
.env.*.local

# Storage (models, datasets, artifacts — too large for git)
unlearn-studio/storage/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Test/cache
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
npm-debug.log*

# Temp
.tmp/
temp/

# Desktop build artifacts (distributed via AWS deploy scripts, never in git).
# The osapps/<os>/ folders themselves ARE tracked — each contains a .gitignore
# that ignores every artifact but keeps the folder + its README in git.
unlearn-studio/server/osapps/**/*.dmg
unlearn-studio/server/osapps/**/*.exe
unlearn-studio/server/osapps/**/*.msi
unlearn-studio/server/osapps/**/*.AppImage
unlearn-studio/server/osapps/**/*.deb
unlearn-studio/server/osapps/**/*.rpm
unlearn-studio/server/osapps/**/*.blockmap
unlearn-studio/server/osapps/**/*.zip
unlearn-studio/apps/desktop/dist/
