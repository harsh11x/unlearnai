{
  "appId": "com.remapstudios.desktop",
  "productName": "Remap Studios",
  "copyright": "Copyright © 2026 Remap Studios",
  "directories": {
    "output": "../dist/win",
    "buildResources": "../mac/build"
  },
  "files": [
    "**/*",
    "!node_modules/.cache/**",
    "!build-mac.sh",
    "!../mac/**",
    "!../win/**",
    "!../dist/**"
  ],
  "extraResources": [
    {
      "from": "../backend",
      "to": "backend",
      "filter": ["**/*.py", "requirements.txt"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "../mac/build/icon.ico",
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "../mac/build/icon.ico",
    "uninstallerIcon": "../mac/build/icon.ico",
    "installerHeaderIcon": "../mac/build/icon.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Remap Studios"
  },
  "portable": {
    "artifactName": "${productName}-${version}-portable.${ext}"
  }
}
