# ═══════════════════════════════════════════════════════
#  REMAP STUDIOS — Server Environment Variables
#  Copy this to .env and fill in your real values
# ═══════════════════════════════════════════════════════

# Server
PORT=3001
NODE_ENV=production
SERVER_URL=http://13.204.245.212:3001

# ── Razorpay (Payment Gateway) ──
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Razorpay Plan IDs (create these in Razorpay Dashboard → Subscriptions → Plans)
# Plan 1: Pro ₹999/month
# Plan 2: Business ₹2,999/month
RAZORPAY_PLAN_PRO_MONTHLY=plan_XXXXXXXXXX
RAZORPAY_PLAN_BUSINESS_MONTHLY=plan_XXXXXXXXXX

# ── Supabase ──
# Get from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Firebase (for token verification) ──
FIREBASE_PROJECT_ID=remapstudios-5b9b0

# ── Build Upload Token (protects upload endpoint) ──
UPLOAD_TOKEN=remap-builds-secret-2024
